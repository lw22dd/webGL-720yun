### 数据持久化测试 - 创建测试用户
# 描述：创建用于持久化测试的用户
# 预期：用户创建成功
POST http://localhost:7000/api/v1/user/admin/create
Content-Type: application/json
Authorization: Bearer {{admin_access_token}}

{
  "username": "persistuser",
  "password": "123456",
  "email": "persist@example.com",
  "phone": "13999999999",
  "nickname": "持久化测试用户",
  "role_id": 2
}

@persist_user_id = {{$response.body.data.id}}


### 数据持久化测试 - 验证用户存在
# 描述：验证持久化测试用户存在
# 预期：能正确获取用户信息
GET http://localhost:7000/api/v1/user/admin/{{persist_user_id}}
Authorization: Bearer {{admin_access_token}}


### 数据持久化测试 - 服务重启后验证
# 描述：重启服务后验证用户数据是否仍然存在
# 操作步骤：
# 1. 停止当前服务
# 2. 重启服务
# 3. 重新获取管理员令牌
# 4. 执行此请求
# 预期：用户数据完整保留，无丢失
# GET http://localhost:7000/api/v1/user/admin/{{persist_user_id}}
# Authorization: Bearer {{new_admin_access_token}}


### 数据持久化测试 - 事务完整性验证
# 描述：测试事务操作的完整性，确保要么全部成功，要么全部失败
# 预期：事务中的操作要么全部成功，要么全部回滚
POST http://localhost:7000/api/v1/user/admin/transaction-test
Content-Type: application/json
Authorization: Bearer {{admin_access_token}}

{
  "test_scenario": "full_transaction",
  "data": {
    "new_user": {
      "username": "transactionuser",
      "password": "123456",
      "email": "transaction@example.com",
      "phone": "13200000000",
      "nickname": "事务测试用户",
      "role_id": 2
    },
    "update_user_id": {{persist_user_id}},
    "update_data": {
      "nickname": "持久化测试用户-更新"
    }
  }
}